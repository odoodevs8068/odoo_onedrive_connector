<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record model="ir.ui.view" id="view_totp_form_inherit">
        <field name="name">view_totp_form_inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="inside">
                <group style="margin-top: 30px;">
                    <group string="Microsoft OneDrive" >
                        <field name="one_drive_config_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>


</odoo>